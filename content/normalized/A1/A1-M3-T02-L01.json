  "context": {
    "title": "A family photo",
    "dialogue": [
      {
        "speaker": "Lia",
        "english": "Who is this?",
        "spanish": "¿Quién es esta persona?"
      },
      {
        "speaker": "Marco",
        "english": "This is my mother. Her name is Rosa.",
        "spanish": "Esta es mi madre. Se llama Rosa."
      },
      {
        "speaker": "Lia",
        "english": "And who are they?",
        "spanish": "¿Y quiénes son ellos?"
      },
      {
        "speaker": "Marco",
        "english": "They are my brother and sister.",
        "spanish": "Son mi hermano y mi hermana."
      },
      {
        "speaker": "Lia",
        "english": "Do you have a big family?",
        "spanish": "¿Tienes una familia grande?"
      },
      {
        "speaker": "Marco",
        "english": "No, I don't. My family is small.",
        "spanish": "No. Mi familia es pequeña."
      }
    ]
  },
  "explanation_es": "Para presentar una persona usa This is my + familiar: This is my mother. Para varias personas usa These are my parents. Pregunta Who is this? para una persona y Who are they? para varias. My indica posesión: my mother, my brother, my family.",
  "spanish_speaker_notes": [
    "Family puede ser singular como grupo: My family is small.",
    "Parents siempre es plural: My parents are...",
    "No uses this are; this es singular y these es plural.",
    "Brother/sister son relaciones familiares; cousin significa primo o prima."
  ],
