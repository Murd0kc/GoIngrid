  "context": {
    "title": "Changing a meeting",
    "dialogue": [
      {
        "speaker": "Maya",
        "english": "Are you free on Thursday?",
        "spanish": "¿Estás libre el jueves?"
      },
      {
        "speaker": "Leo",
        "english": "I'm sorry, I can't. I have an appointment.",
        "spanish": "Lo siento, no puedo. Tengo una cita."
      },
      {
        "speaker": "Maya",
        "english": "How about Friday at three?",
        "spanish": "¿Qué tal el viernes a las tres?"
      },
      {
        "speaker": "Leo",
        "english": "Yes, that works for me.",
        "spanish": "Sí, me funciona."
      },
      {
        "speaker": "Maya",
        "english": "Great. Let's confirm: Friday at three.",
        "spanish": "Perfecto. Confirmemos: viernes a las tres."
      }
    ]
  },
  "explanation_es": "Para proponer una cita usa Are you free on...? o How about Friday at three? Para confirmar puedes decir That works for me o Let's confirm. Usa on con el día y at con la hora. Si no puedes, responde I'm sorry, I can't y ofrece otra opción.",
  "spanish_speaker_notes": [
    "How about...? no pregunta literalmente 'cómo sobre'; propone una alternativa.",
    "That works for me significa que el horario te conviene.",
    "Usa on Friday y at three en la misma cita.",
    "Una respuesta útil a una negativa ofrece otro día u hora."
  ],
